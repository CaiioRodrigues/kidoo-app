# Variáveis públicas do app (embutidas no bundle — NUNCA coloque segredos aqui).
# Tudo que começa com EXPO_PUBLIC_ é visível para quem baixar o app.
EXPO_PUBLIC_API_URL=https://api.kidoo.app
EXPO_PUBLIC_ENV=development

# Chaves privadas (Stripe secret, service role, assinatura de push, etc.)
# vivem APENAS no backend ou em EAS secrets — jamais neste arquivo nem no bundle.

# Backend. Sem estas duas, o app roda com o backend em memória (modo
# demonstração) — que é o padrão e continua sendo o contrato que o adapter real
# satisfaz. Com elas, fala com o Supabase.
# A anon key é pública por natureza: quem protege os dados é a RLS, não o
# segredo da chave. A service_role NUNCA vai aqui — ela ignora RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
