{
  "expo": {
    "name": "Kidoo",
    "slug": "kidoo-app",
    "scheme": "kidoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#6A3FC6",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.kidoo.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Kidoo",
        "NSCameraUsageDescription": "O Kidoo usa a câmera apenas para você adicionar a foto do perfil da criança. A imagem fica no dispositivo até você confirmar o envio.",
        "NSPhotoLibraryUsageDescription": "O Kidoo acessa suas fotos apenas para você escolher a foto de perfil da criança.",
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização apenas para mostrar atividades perto de você. Você pode escolher a cidade manualmente."
      }
    },
    "android": {
      "package": "com.kidoo.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#6A3FC6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6A3FC6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Kidoo acessa suas fotos apenas para você escolher a foto de perfil da criança.",
          "cameraPermission": "O Kidoo usa a câmera apenas para você adicionar a foto do perfil da criança."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
