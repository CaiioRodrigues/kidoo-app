# Aponta o painel para o mesmo projeto Supabase do app.
# Sem estas duas, o painel roda em modo demonstração, com dados fictícios.
#
# A anon key é pública por natureza: quem protege os dados é a RLS, não o
# segredo da chave. A service_role NUNCA vai aqui — ela ignora RLS, e num
# bundle de navegador daria a qualquer visitante o banco inteiro.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
